{
  "name": "iptv-viewer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "start-remote": "ng serve --poll=1000 --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "deploy": "ng deploy --base-href=/iptv-viewer/",
    "prod": "ng build --configuration=production"
  },
  "dependencies": {
    "@angular/animations": "20.0.5",
    "@angular/cdk": "20.0.5",
    "@angular/common": "20.0.5",
